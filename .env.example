# Audience Radar: environment variables (names only, no real values).
# Copy to backend/.env and frontend/.env as noted. Never commit real keys.

# ---------- backend/.env ----------
MONGO_URL=
DB_NAME=
CORS_ORIGINS=

# AI model layer (server only). Empty GEMINI_API_KEY = every AI step uses labelled sample answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_DAILY_LIMIT_PER_BROWSER=20

# Data sources. DATA_MODE=auto uses a live source wherever its key is set, demo = always sample data.
DATA_MODE=auto
X_BEARER_TOKEN=
X_INCLUDE_AUTHOR_METRICS=false
X_COST_PER_POST_USD=0.005
X_COST_PER_AUTHOR_USD=0.01
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
YOUTUBE_API_KEY=

# Pricing and caps
PRICE_PER_POST_USD=0.01
MAX_POSTS_PER_RUN=100
DAILY_X_POST_CAP=500

# Payment (only "mock" is supported in this version; wallet values are unused for now)
PAYMENT_MODE=mock
RECEIVER_WALLET_ADDRESS=
SOLANA_RPC_URL=

# Optional sign-in (managed Clerk)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---------- frontend/.env ----------
REACT_APP_BACKEND_URL=
